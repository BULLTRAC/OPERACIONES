rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function rolDoc() { return /databases/$(database)/documents/roles/$(request.auth.token.email); }
    function tieneRol() { return request.auth != null && exists(rolDoc()); }
    function esAdmin()  { return tieneRol() && get(rolDoc()).data.rol == 'admin'; }
    function esEditor() { return tieneRol() && get(rolDoc()).data.rol in ['admin', 'editor']; }

    // Roles: cada uno lee el suyo; solo el admin los crea o cambia
    match /roles/{correo} {
      allow read: if request.auth != null && (correo == request.auth.token.email || esAdmin());
      allow write: if esAdmin();
    }

    // Configuración: flota/cfg la editan admin y editor; flota/usuarios (y _meta) solo el admin
    match /flota/{id} {
      allow read: if tieneRol();
      allow write: if esAdmin() || (esEditor() && !id.matches('usuarios.*') && id != '_meta');
    }

    // Un documento por registro: leen todos los que tienen rol; escriben admin y editor
    match /{col}/{id} {
      allow read: if col in ['vehiculos', 'conductores', 'viajes', 'registro'] && tieneRol();
      allow write: if col in ['vehiculos', 'conductores', 'viajes', 'registro'] && esEditor();
    }
  }
}
