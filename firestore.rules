rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function rolDoc() { return /databases/$(database)/documents/roles/$(request.auth.token.email); }
    function tieneRol() { return request.auth != null && exists(rolDoc()); }
    function miRol()    { return get(rolDoc()).data.rol; }
    function esAdmin()  { return tieneRol() && miRol() == 'admin'; }
    function esEditor() { return tieneRol() && miRol() in ['admin', 'editor']; }
    // V18: el validador solo puede editar la orden de servicio y validar (colección validaciones)
    function esValidador() { return tieneRol() && miRol() in ['admin', 'editor', 'validador']; }

    // Roles: cada uno lee el suyo; solo el admin los crea o cambia
    match /roles/{correo} {
      allow read: if request.auth != null && (correo == request.auth.token.email || esAdmin());
      allow write: if esAdmin();
    }

    // Configuración: flota/cfg la editan admin y editor; flota/usuarios (y _meta) solo el admin
    match /flota/{id} {
      allow read: if tieneRol();
      allow write: if esAdmin() || (esEditor() && !id.matches('usuarios.*') && id != '_meta');
    }

    // Orden de servicio y validación de cada viaje (doc id = id del viaje)
    match /validaciones/{id} {
      allow read: if tieneRol();
      allow write: if esValidador();
    }

    // Registro de cambios: el validador también escribe aquí (deja constancia de lo que valida)
    match /registro/{id} {
      allow read: if tieneRol();
      allow write: if esValidador();
    }

    // Un documento por registro: leen todos los que tienen rol; escriben admin y editor
    match /{col}/{id} {
      allow read: if col in ['vehiculos', 'conductores', 'viajes'] && tieneRol();
      allow write: if col in ['vehiculos', 'conductores', 'viajes'] && esEditor();
    }
  }
}
